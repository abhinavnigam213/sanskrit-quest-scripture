-- Script 0005: Create scripture.GetVersesDetails stored procedure with OUT parameters
DROP PROCEDURE IF EXISTS scripture.GetVersesDetails(INT);
DROP FUNCTION IF EXISTS scripture.GetVersesDetails(INT);
CREATE OR REPLACE PROCEDURE scripture.GetVersesDetails(
    p_verse_id INT,
    OUT o_verse_number VARCHAR(50),
    OUT o_verse_type VARCHAR(50),
    OUT o_content_sanskrit TEXT,
    OUT o_translation_en TEXT,
    OUT o_translation_hi TEXT,
    OUT o_word_breakdown JSONB,
    OUT o_source_id INT,
    OUT o_search_weight INT,
    OUT o_meta_tags JSONB,
    OUT o_hierarchy_id INT,
    OUT o_hierarchy_parent_id INT,
    OUT o_hierarchy_local_label VARCHAR(100),
    OUT o_hierarchy_path TEXT,
    OUT o_hierarchy_node_type VARCHAR(50),
    OUT o_hierarchy_title_en TEXT,
    OUT o_hierarchy_title_hi TEXT,
    OUT o_hierarchy_title_sa TEXT,
    OUT o_scripture_id INT,
    OUT o_scripture_code VARCHAR(100),
    OUT o_scripture_title_en TEXT,
    OUT o_scripture_title_hi TEXT,
    OUT o_scripture_title_sa TEXT
)
LANGUAGE plpgsql
AS $$
BEGIN
    SELECT 
        v.verse_number,
        v.verse_type,
        v.content_sanskrit,
        v.verse_data->>'translation_en',
        v.verse_data->>'translation_hi',
        v.verse_data->'word_breakdown',
        v.source_id,
        v.search_weight,
        v.meta_tags,
        h.hierarchy_id,
        h.parent_id,
        h.local_label,
        h.path::text,
        h.node_type,
        h.titles->>'en',
        h.titles->>'hi',
        h.titles->>'sa',
        s.scripture_id,
        s.code,
        s.titles->>'en',
        s.titles->>'hi',
        s.titles->>'sa'
    INTO 
        o_verse_number,
        o_verse_type,
        o_content_sanskrit,
        o_translation_en,
        o_translation_hi,
        o_word_breakdown,
        o_source_id,
        o_search_weight,
        o_meta_tags,
        o_hierarchy_id,
        o_hierarchy_parent_id,
        o_hierarchy_local_label,
        o_hierarchy_path,
        o_hierarchy_node_type,
        o_hierarchy_title_en,
        o_hierarchy_title_hi,
        o_hierarchy_title_sa,
        o_scripture_id,
        o_scripture_code,
        o_scripture_title_en,
        o_scripture_title_hi,
        o_scripture_title_sa
    FROM scripture.verses v
    JOIN scripture.hierarchy h ON v.hierarchy_id = h.hierarchy_id
    JOIN scripture.scriptures s ON h.scripture_id = s.scripture_id
    WHERE v.verse_id = p_verse_id;
END;
$$;
