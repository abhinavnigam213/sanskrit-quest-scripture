-- Script 0004: Create scripture.GetScriptureDetails function returning a table
DROP PROCEDURE IF EXISTS scripture.GetScriptureDetails(INT, REFCURSOR);
DROP FUNCTION IF EXISTS scripture.GetScriptureDetails(INT);

CREATE OR REPLACE FUNCTION scripture.GetScriptureDetails(p_scripture_id INT)
RETURNS TABLE (
    scripture_id INT,
    scripture_code VARCHAR(100),
    scripture_author JSONB,
    scripture_titles JSONB,
    scripture_description JSONB,
    hierarchy_id INT,
    parent_id INT,
    local_label VARCHAR(100),
    path TEXT,
    node_type VARCHAR(50),
    hierarchy_titles JSONB,
    hierarchy_description JSONB,
    sequence_number INT,
    direct_verse_count INT,
    recursive_verse_count INT
)
LANGUAGE sql
AS $$
    WITH RECURSIVE hierarchy_tree AS (
        -- Anchor: Root nodes for the given scripture
        SELECT 
            h.hierarchy_id,
            h.parent_id,
            h.local_label,
            h.path,
            h.node_type,
            h.titles,
            h.description,
            h.sequence_number,
            ARRAY[h.sequence_number] AS sort_path
        FROM scripture.hierarchy h
        WHERE h.scripture_id = p_scripture_id AND h.parent_id IS NULL
        
        UNION ALL
        
        -- Recursive: Child nodes
        SELECT 
            c.hierarchy_id,
            c.parent_id,
            c.local_label,
            c.path,
            c.node_type,
            c.titles,
            c.description,
            c.sequence_number,
            p.sort_path || c.sequence_number AS sort_path
        FROM scripture.hierarchy c
        JOIN hierarchy_tree p ON c.parent_id = p.hierarchy_id
    ),
    verse_counts AS (
        SELECT 
            h.hierarchy_id,
            (SELECT COUNT(*)::INT FROM scripture.verses v WHERE v.hierarchy_id = h.hierarchy_id) AS direct_count,
            (
                SELECT COUNT(*)::INT 
                FROM scripture.verses v 
                JOIN scripture.hierarchy sub_h ON v.hierarchy_id = sub_h.hierarchy_id 
                WHERE sub_h.path <@ h.path
            ) AS recursive_count
        FROM scripture.hierarchy h
        WHERE h.scripture_id = p_scripture_id
    )
    SELECT 
        s.scripture_id,
        s.code AS scripture_code,
        s.author AS scripture_author,
        s.titles AS scripture_titles,
        s.description AS scripture_description,
        ht.hierarchy_id,
        ht.parent_id,
        ht.local_label,
        ht.path::text,
        ht.node_type,
        ht.titles AS hierarchy_titles,
        ht.description AS hierarchy_description,
        ht.sequence_number,
        COALESCE(vc.direct_count, 0) AS direct_verse_count,
        COALESCE(vc.recursive_count, 0) AS recursive_verse_count
    FROM scripture.scriptures s
    JOIN hierarchy_tree ht ON s.scripture_id = p_scripture_id
    LEFT JOIN verse_counts vc ON ht.hierarchy_id = vc.hierarchy_id
    ORDER BY ht.sort_path;
$$;
