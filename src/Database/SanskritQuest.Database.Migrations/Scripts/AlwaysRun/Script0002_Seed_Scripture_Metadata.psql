-- ========================================================================
-- 4. SEED: scripture.categories
-- ========================================================================
INSERT INTO scripture.categories (category_id, category_name, description) VALUES 
(1, 'Shruti', '{"en": "That which is heard eternally by sages", "hi": "वह ज्ञान जो ऋषियों द्वारा सुना गया था"}'::jsonb), 
(2, 'Smriti', '{"en": "That which is remembered by human tradition", "hi": "वह ज्ञान जो स्मृति और परंपरा पर आधारित है"}'::jsonb)
ON CONFLICT (category_id) DO UPDATE SET 
    category_name = EXCLUDED.category_name, 
    description = EXCLUDED.description;

-- ========================================================================
-- 5. SEED: scripture.classes
-- ========================================================================
INSERT INTO scripture.classes (class_id, category_id, class_name, description) VALUES 
(1, 2, 'Itihasa (Epics)', '{"en": "Historical epic narratives", "hi": "ऐतिहासिक महाकाव्य ग्रंथ"}'::jsonb),
(2, 1, 'Samhita', '{"en": "Core mantra text of the Vedas", "hi": "वेदों का मुख्य मंत्र भाग"}'::jsonb),
(3, 1, 'Brahmana', '{"en": "Explanations of rituals and hymns", "hi": "कर्मकांड और अनुष्ठान के व्याख्या ग्रंथ"}'::jsonb),
(4, 1, 'Aranyaka', '{"en": "Forest treatises on rituals and meditation", "hi": "वन में पढ़े जाने वाले दार्शनिक ग्रंथ"}'::jsonb),
(5, 1, 'Upanishad', '{"en": "Philosophical treatises on ultimate reality", "hi": "परम सत्य पर आधारित दार्शनिक ग्रंथ"}'::jsonb),
(6, 2, 'Purana', '{"en": "Chronicles of ancient histories and legends", "hi": "प्राचीन इतिहास और कथाओं के ग्रंथ"}'::jsonb),
(7, 2, 'Sutra / Shastra', '{"en": "Aphorisms and treatise texts on law or philosophy", "hi": "सूत्र और शास्त्र ग्रंथ"}'::jsonb)
ON CONFLICT (class_id) DO UPDATE SET 
    category_id = EXCLUDED.category_id, 
    class_name = EXCLUDED.class_name, 
    description = EXCLUDED.description;

-- ========================================================================
-- 6. SEED: scripture.commentators
-- ========================================================================
INSERT INTO scripture.commentators (commentator_id, name, philosophy_id, authority_rank, biography) VALUES 
(1, 'Adi Shankara', 1, 10, '{"en": "Founder of Advaita philosophy", "hi": "अद्वैत वेदांत के संस्थापक"}'::jsonb),
(2, 'Ramanuja', 2, 9, '{"en": "Proponent of Vishishtadvaita philosophy", "hi": "विशिष्टाद्वैत दर्शन के मुख्य प्रवर्तक"}'::jsonb),
(3, 'Madhvacharya', 3, 9, '{"en": "Proponent of Dvaita philosophy", "hi": "द्वैत दर्शन के प्रवर्तक"}'::jsonb),
(4, 'Abhinavagupta', 1, 8, '{"en": "Great philosopher and commentator of Kashmir Shaivism", "hi": "कश्मीर शैव दर्शन के महान व्याख्याकार"}'::jsonb),
(5, 'Jnaneshwar', 1, 8, '{"en": "Marathi saint and commentator of Bhagavad Gita", "hi": "भगवद्गीता के महान मराठी संत और व्याख्याकार"}'::jsonb),
(6, 'Vallabhacharya', 10, 8, '{"en": "Proponent of Shuddhadvaita philosophy", "hi": "शुद्धाद्वैत दर्शन के प्रवर्तक"}'::jsonb),
(7, 'Nimbarkacharya', 11, 8, '{"en": "Proponent of Dvaitadvaita philosophy", "hi": "द्वैताद्वैत दर्शन के प्रवर्तक"}'::jsonb)
ON CONFLICT (commentator_id) DO UPDATE SET 
    name = EXCLUDED.name, 
    philosophy_id = EXCLUDED.philosophy_id, 
    authority_rank = EXCLUDED.authority_rank, 
    biography = EXCLUDED.biography;

-- ========================================================================
-- 7. SEED: scripture.scriptures
-- ========================================================================
INSERT INTO scripture.scriptures (scripture_id, code, titles, description, category_id, class_id, source_id, search_weight, meta_tags) VALUES 
(1, 'Bhagavad_Gita', 
 '{"en": "Bhagavad Gita", "hi": "भगवद्गीता", "sa": "श्रीमद्भगवद्गीता"}'::jsonb, 
 '{"en": "The dialogue between Sri Krishna and Arjuna on duty and duty-less action.", "hi": "कर्तव्य और निष्काम कर्म पर श्री कृष्ण और अर्जुन के बीच संवाद।"}'::jsonb, 
 2, 1, 1, 10, '["Gita", "Epic", "Mahabharata"]'::jsonb),
(2, 'Valmiki_Ramayana',
 '{"en": "Valmiki Ramayana", "hi": "वाल्मीकि रामायण", "sa": "वाल्मीकिरामायणम्"}'::jsonb,
 '{"en": "The ancient Sanskrit epic poem detailing the life and journey of Prince Rama, composed by the sage Valmiki.", "hi": "ऋषि वाल्मीकि द्वारा रचित प्राचीन संस्कृत महाकाव्य, जो राजकुमार राम के जीवन और यात्रा का वर्णन करता है।"}'::jsonb,
 2, 1, 3, 10, '["Ramayana", "Epic", "Rama", "Valmiki"]'::jsonb)
ON CONFLICT (scripture_id) DO UPDATE SET 
    code = EXCLUDED.code,
    titles = EXCLUDED.titles,
    description = EXCLUDED.description,
    category_id = EXCLUDED.category_id,
    class_id = EXCLUDED.class_id,
    source_id = EXCLUDED.source_id,
    search_weight = EXCLUDED.search_weight,
    meta_tags = EXCLUDED.meta_tags;

-- ========================================================================
-- 8. RESET SEQUENCE NUMBERS (To prevent auto-increment collisions)
-- ========================================================================
SELECT setval('scripture.sects_sect_id_seq', COALESCE((SELECT MAX(sect_id) FROM scripture.sects), 1));
SELECT setval('scripture.philosophies_philosophy_id_seq', COALESCE((SELECT MAX(philosophy_id) FROM scripture.philosophies), 1));
SELECT setval('scripture.deities_deity_id_seq', COALESCE((SELECT MAX(deity_id) FROM scripture.deities), 1));
SELECT setval('scripture.categories_category_id_seq', COALESCE((SELECT MAX(category_id) FROM scripture.categories), 1));
SELECT setval('scripture.classes_class_id_seq', COALESCE((SELECT MAX(class_id) FROM scripture.classes), 1));
SELECT setval('scripture.commentators_commentator_id_seq', COALESCE((SELECT MAX(commentator_id) FROM scripture.commentators), 1));
SELECT setval('scripture.scriptures_scripture_id_seq', COALESCE((SELECT MAX(scripture_id) FROM scripture.scriptures), 1));

