-- Script 0003: Seed scripture schema lookup metadata in AlwaysRun stage
-- ========================================================================
-- 1. SEED: scripture.sects
-- ========================================================================
INSERT INTO scripture.sects (sect_id, sect_name) VALUES 
(1, 'Vaishnavism'),
(2, 'Shaivism'),
(3, 'Shaktism'),
(4, 'Smartism'),
(5, 'Saurism'),
(6, 'Ganapatism'),
(7, 'Kaumaram')
ON CONFLICT (sect_id) DO UPDATE SET 
    sect_name = EXCLUDED.sect_name;

