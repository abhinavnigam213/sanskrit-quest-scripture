-- Script 0003: Seed scripture schema lookup metadata in AlwaysRun stage
-- ========================================================================
-- 1. SEED: scripture.sects
-- ========================================================================
INSERT INTO scripture.sects (sect_id, sect_name) VALUES 
(1, 'Vaishnavism'),
(2, 'Shaivism'),
(3, 'Shaktism'),
(4, 'Smartism'),
(5, 'Saurism'),
(6, 'Ganapatism'),
(7, 'Kaumaram')
ON CONFLICT (sect_id) DO UPDATE SET 
    sect_name = EXCLUDED.sect_name;

-- ========================================================================
-- 2. SEED: scripture.philosophies
-- ========================================================================
INSERT INTO scripture.philosophies (philosophy_id, philosophy_name) VALUES 
(1, 'Advaita Vedanta'),
(2, 'Vishishtadvaita'),
(3, 'Dvaita'),
(4, 'Samkhya'),
(5, 'Yoga'),
(6, 'Nyaya'),
(7, 'Vaisheshika'),
(8, 'Mimamsa'),
(9, 'Bhedabheda'),
(10, 'Shuddhadvaita'),
(11, 'Dvaitadvaita')
ON CONFLICT (philosophy_id) DO UPDATE SET 
    philosophy_name = EXCLUDED.philosophy_name;

-- ========================================================================
-- 3. SEED: scripture.deities
-- ========================================================================
INSERT INTO scripture.deities (deity_id, deity_name) VALUES 
